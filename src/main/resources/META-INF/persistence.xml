<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="sghaPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entidades do domínio (anotadas com @Entity na camada model). -->
        <class>br.ufrrj.sgha.model.Discente</class>
        <class>br.ufrrj.sgha.model.Solicitacao</class>
        <class>br.ufrrj.sgha.model.HistoricoStatus</class>
        <class>br.ufrrj.sgha.model.MembroComissao</class>
        <class>br.ufrrj.sgha.model.AtuacaoComissao</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- URL, usuário e senha são definidos em PersistenceListener/JPAUtil
                 (variáveis SGHA_DB_URL, SGHA_DB_USER, SGHA_DB_PASSWORD). -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>

            <!-- Cria e atualiza as tabelas a partir das entidades. -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.connection.pool_size" value="10"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
